# OgniOra: copia in .env.local. Non committare mai valori reali.

# ─── Pubblicazione ────────────────────────────────────────────────────────────
# manual | assisted | automatic. "automatic" è rifiutato fuori da production.
PUBLICATION_MODE=manual
# Interruttore generale: finché è false nessun upload può essere pubblico.
ALLOW_PUBLIC_PUBLICATION=false
# development | staging | production
OGNIORA_ENV=development

# ─── Supabase (progetto dedicato, mai condiviso con Lepefy) ───────────────────
SUPABASE_URL=https://your-project.supabase.co
# Solo job fidati su GitHub Actions. Mai nel browser, mai negli artifact.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Provider IA ──────────────────────────────────────────────────────────────
# Basta una chiave: le rotte senza chiave vengono saltate. Rotte in config/ai.json.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Blocco duro: oltre questa spesa stimata mensile nessuna chiamata parte.
AI_MONTHLY_BUDGET_USD=20
# AI_ROUTE_SCRIPT=anthropic:claude-sonnet-5-5,openai:gpt-6-luna
# AI_ROUTE_VERIFY=anthropic:claude-haiku-5-5

# ─── Percorso legacy (Vercel), attivo fino al collaudo del nuovo ──────────────
# Obbligatorio: senza valore (min. 16 caratteri) gli endpoint rispondono 401.
# Generalo con: openssl rand -hex 32
CRON_SECRET=
CLAUDE_MODEL=claude-haiku-4-5-20251001
NEWS_CATEGORIA=Italia
NEWS_NUM=5

# ─── Text-to-speech ───────────────────────────────────────────────────────────
# azure | elevenlabs
TTS_PROVIDER=azure
# Listening Test only: JSON key of a Google service account, stored as a GitHub secret.
GOOGLE_TTS_CREDENTIALS_JSON=
AZURE_TTS_KEY=
AZURE_TTS_REGION=westeurope
AZURE_TTS_VOICE=it-IT-DiegoNeural
ELEVENLABS_API_KEY=

# ─── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
