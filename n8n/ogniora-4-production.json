{
  "name": "OgniOra 4 - Produzione e upload privato",
  "active": false,
  "nodes": [
    {
      "id": "a4000000-0000-4000-8000-000000000001",
      "name": "Ogni 10 minuti",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "a4000000-0000-4000-8000-000000000002",
      "name": "Leggi job in coda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "OgniOra Supabase"
        }
      },
      "parameters": {
        "url": "={{ $env.OGNIORA_SUPABASE_URL }}/rest/v1/production_jobs?status=eq.queued&kind=in.(tts,render)&select=id&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "a4000000-0000-4000-8000-000000000003",
      "name": "Avvia Production su GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OgniOra GitHub"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/robertinsmartinvestor-gif/Flash-Info/actions/workflows/production.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"ref\": \"main\", \"inputs\": { \"mode\": \"produce\" } }",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "a4000000-0000-4000-8000-000000000004",
      "name": "Leggi upload privati in attesa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        400
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "OgniOra Supabase"
        }
      },
      "parameters": {
        "url": "={{ $env.OGNIORA_SUPABASE_URL }}/rest/v1/publication_queue?status=eq.pending&privacy=eq.private&publish_at=is.null&select=id&order=created_at&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "a4000000-0000-4000-8000-000000000005",
      "name": "Avvia Distribution su GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OgniOra GitHub"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/robertinsmartinvestor-gif/Flash-Info/actions/workflows/distribution.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"ref\": \"main\", \"inputs\": { \"queue_id\": \"{{ $json.id }}\" } }",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Ogni 10 minuti": {
      "main": [
        [
          {
            "node": "Leggi job in coda",
            "type": "main",
            "index": 0
          },
          {
            "node": "Leggi upload privati in attesa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leggi job in coda": {
      "main": [
        [
          {
            "node": "Avvia Production su GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leggi upload privati in attesa": {
      "main": [
        [
          {
            "node": "Avvia Distribution su GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
