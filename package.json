{
  "name": "ogniora",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "job:ingest": "tsx src/cli/ingest.ts",
    "job:compose": "tsx src/cli/compose.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark": "tsx src/cli/benchmark.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "^5.12.0",
    "googleapis": "^189.0.0",
    "next": "^16.4.5",
    "openai": "^7.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
